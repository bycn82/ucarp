# Makefile for UCARP (no autotools or configure needed)
#
# FreeBSD 7 : make            (bmake, base system)
# CetOS 5   : make            (GNU make >= 4.0, needs libpcap-dev / libpcap-devel)
#

PROG     = ucarp
VERSION  = 1.5.2
PREFIX  ?= /usr/local
SBINDIR ?= $(PREFIX)/sbin

OS != uname -s

CFLAGS  ?= -O2 -g
CFLAGS  += -Wall
LIBS     = -lpcap

SRCS = ucarp.c carp.c crypto-sha1.c daemonize.c fakesnprintf.c fillmac.c \
       garp.c log.c mysnprintf.c spawn.c bsd-getopt_long.c
OBJS = ucarp.o carp.o crypto-sha1.o daemonize.o fakesnprintf.o fillmac.o \
       garp.o log.o mysnprintf.o spawn.o bsd-getopt_long.o
HDRS = bsd-getopt_long.h carp_p.h crypto.h crypto-sha1.h daemonize.h \
       fakesnprintf.h fillmac.h garp.h gettext.h globals.h ip_carp.h log.h \
       mysnprintf.h spawn.h syslognames.h ucarp.h ucarp_p.h

# ---- Common settings ----
DEFS_COMMON = \
	-DPACKAGE='"ucarp"' \
	-DVERSION='"$(VERSION)"' \
	-DPACKAGE_STRING='"ucarp $(VERSION)"' \
	-DPACKAGE_BUGREPORT='"the UCARP maintainers"' \
	-DLOCALEDIR='"$(PREFIX)/share/locale"' \
	-DSTDC_HEADERS=1 -DHAVE_STDLIB_H=1 -DHAVE_STRING_H=1 -DHAVE_STRINGS_H=1 \
	-DHAVE_UNISTD_H=1 -DHAVE_INTTYPES_H=1 -DHAVE_FCNTL_H=1 \
	-DHAVE_SYS_IOCTL_H=1 -DHAVE_SYS_TIME_H=1 -DTIME_WITH_SYS_TIME=1 \
	-DHAVE_SYS_WAIT_H=1 -DHAVE_WAITPID=1 \
	-DHAVE_NETINET_IN_H=1 -DHAVE_NETINET_IN_SYSTM_H=1 \
	-DSIZEOF_SHORT=2 -DSIZEOF_INT=4 \
	-DHAVE_SNPRINTF=1 -DHAVE_VSNPRINTF=1 -DCONF_SNPRINTF_TYPE=8 \
	-DHAVE_GETOPT_LONG=1 -DHAVE_SYSLOG_NAMES=1 \
	-DHAVE_SETLOCALE=1 -DHAVE_RANDOM=1 -DHAVE_STRTOULL=1 \
	-DHAVE_SETEUID=1 -DHAVE_SETEGID=1 \
	-DRETSIGTYPE=void

# ---- Linux: MAC via SIOCGIFHWADDR; glibc has no __packed ----
DEFS_Linux = -D_GNU_SOURCE \
	-D'__packed=__attribute__((__packed__))'

# ---- FreeBSD: MAC via getifaddrs()/AF_LINK; arc4random/srandomdev ----
DEFS_FreeBSD = \
	-DHAVE_IFADDRS_H=1 -DHAVE_GETIFADDRS=1 \
	-DHAVE_NET_IF_DL_H=1 -DHAVE_NET_IF_TYPES_H=1 -DHAVE_SYS_SOCKIO_H=1 \
	-DHAVE_ARC4RANDOM=1 -DHAVE_SRANDOMDEV=1

# Big-endian CPU: make EXTRA_DEFS=-DWORDS_BIGENDIAN
EXTRA_DEFS ?=

DEFS = $(DEFS_COMMON) $(DEFS_$(OS)) $(EXTRA_DEFS)

.SUFFIXES: .c .o

all: $(PROG)

$(PROG): $(OBJS)
	$(CC) $(LDFLAGS) -o $(PROG) $(OBJS) $(LIBS)

.c.o:
	$(CC) $(CFLAGS) $(CPPFLAGS) -I. $(DEFS) -c $< -o $@

$(OBJS): config.h $(HDRS)

config.h:
	@echo "/* generated by Makefile: settings are passed via -D */" > config.h

install: $(PROG)
	install -d $(DESTDIR)$(SBINDIR)
	install -m 755 $(PROG) $(DESTDIR)$(SBINDIR)/$(PROG)

clean:
	rm -f $(PROG) $(OBJS) config.h

.PHONY: all install clean
